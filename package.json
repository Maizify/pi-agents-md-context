{
  "name": "pi-agents-md-context",
  "version": "0.1.0",
  "description": "Loads nested AGENTS.md files as context when a file is read, deduped through the visible session projection (no subagents).",
  "keywords": ["pi-package", "pi", "agents-md", "context", "instructions"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maizify/pi-agents-md-context.git"
  },
  "homepage": "https://github.com/Maizify/pi-agents-md-context#readme",
  "bugs": {
    "url": "https://github.com/Maizify/pi-agents-md-context/issues"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
